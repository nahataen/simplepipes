{
  "multipart": [
    { "apply": { "model": "simplepipes:block/extraction_tube_center" } },
    { "when": { "north": "true" }, "apply": { "model": "simplepipes:block/extraction_tube_side" } },
    { "when": { "south": "true" }, "apply": { "model": "simplepipes:block/extraction_tube_side", "y": 180 } },
    { "when": { "east": "true" }, "apply": { "model": "simplepipes:block/extraction_tube_side", "y": 90 } },
    { "when": { "west": "true" }, "apply": { "model": "simplepipes:block/extraction_tube_side", "y": 270 } },
    { "when": { "up": "true" }, "apply": { "model": "simplepipes:block/extraction_tube_side", "x": 270 } },
    { "when": { "down": "true" }, "apply": { "model": "simplepipes:block/extraction_tube_side", "x": 90 } }
  ]
}
